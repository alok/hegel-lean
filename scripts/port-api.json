  "compatibilityNotes": [
    "This is a feature port of the pinned frontend contract to the current pinned native engine, not a port of the Rust engine itself.",
    "Public names and representations use Lean types; third-party Haskell testing adapters are replaced by Lake integration.",
    "Calendar times use the native engines nanosecond precision; durations retain arbitrary-precision picoseconds.",
    "Seeded byte-for-byte agreement between language frontends and hash iteration order is not promised.",
    "Cancellation is cooperative at Lean draw and IO boundaries; foreign blocking IO cannot be forcibly interrupted."
  ],
  "verification": {
    "frontendVersion": "1.0.0",
    "leanVersion": "4.34.0",
    "engineVersion": "0.43.1",
    "localPlatform": "macOS arm64",
    "commands": [
      "lake build hegel_tests hegel_examples hegel_concurrency_tests hegel_panic_probe",
      "lake test",
      "python3 scripts/check_ffi.py",
      "python3 scripts/check_port.py",
      "python3 scripts/test_safety.py",
      "python3 scripts/test_concurrency.py",
      "python3 scripts/test_downstream.py"
    ],
    "platformCI": ".github/workflows/ci.yml"
  }
}
